# Bulb (values from `python -m tinytuya wizard` / devices.json)
BULB_ID=your_device_id
# Reserve this IP in your router's DHCP so it doesn't change
BULB_IP=192.168.1.x
BULB_VERSION=3.5
# Bulb name shown in the web UI and its power draw (for the usage estimate)
BULB_LABEL=Smart lamp
BULB_WATTS=9
# Prefer the podman secret (BULB_KEY_FILE=/run/secrets/bulb_key); only use this for local tests
#BULB_KEY=
# Several bulbs: a devices.json-style file mounted as a secret (replaces BULB_ID/BULB_IP/BULB_KEY)
#BULBS_FILE=/run/secrets/bulbs

# First admin, created only while no user exists yet; manage users in the web UI afterwards.
# Prefer the podman secret (APP_PASSWORD_FILE=/run/secrets/app_password)
APP_USER=admin
#APP_PASSWORD=

# Location for sunrise/sunset (schedules, circadian rhythm, presence simulation); also editable in the UI
#LATITUDE=-23.55
#LONGITUDE=-46.63

# Home Assistant / MQTT (optional)
#MQTT_HOST=192.168.1.y
#MQTT_PORT=1883
#MQTT_USER=smartbulb
#MQTT_PASSWORD=

TZ=America/Sao_Paulo
